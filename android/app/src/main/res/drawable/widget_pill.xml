<?xml version="1.0" encoding="utf-8"?>
<!-- The status pill on a widget's photo: an 85% black backing (was 75%: the green "Working" fell to 4.28:1 at its worst spot on a bright photo; every status colour now at least 7:1 even over a white photo) with a faint outline, so it reads on any photo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#D9000000" />
    <stroke android:width="0.5dp" android:color="#4DFFFFFF" />
    <corners android:radius="999dp" />
</shape>
