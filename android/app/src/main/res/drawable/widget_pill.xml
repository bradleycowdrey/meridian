<?xml version="1.0" encoding="utf-8"?>
<!-- The status pill on a widget's photo: a 75% black backing (every status colour at least 4.5:1 even over a white photo) with a faint outline, so it reads on any photo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#BF000000" />
    <stroke android:width="0.5dp" android:color="#4DFFFFFF" />
    <corners android:radius="999dp" />
</shape>
