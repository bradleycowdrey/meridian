<?xml version="1.0" encoding="utf-8"?>
<!-- A widget tile's soft outline, on every tile (shown by MeridianWidgets.tiles): a 1 dp white 30% line at the edge,
     softened inward by two fainter 1 dp rings (12%, then 5%), so it reads as a slightly blurred, elegant edge rather
     than a hard stroke (RemoteViews cannot blur). The tile's 6 dp corners (less each inset), no fill. An overlay over
     the tile, so the tile's tint never reaches it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
