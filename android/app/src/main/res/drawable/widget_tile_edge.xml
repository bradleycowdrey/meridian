<?xml version="1.0" encoding="utf-8"?>
<!-- A widget tile's edge on off-hours and night tiles (shown by MeridianWidgets.tiles): 1 dp white 32%, the tile's
     6 dp corners, no fill. An overlay over the tile, so the tile's tint never reaches it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke android:width="1dp" android:color="#52FFFFFF" />
    <corners android:radius="6dp" />
</shape>
