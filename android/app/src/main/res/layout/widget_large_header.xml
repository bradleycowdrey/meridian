<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="4dp"
    android:orientation="horizontal">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:text="Meridian" android:textColor="#807870" android:textSize="11sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:orientation="horizontal">
        <TextView style="@style/WidgetLabel" android:text="−1 hr" />
        <TextView style="@style/WidgetLabel" android:text="Now" android:textColor="#FFF1E5" />
        <TextView style="@style/WidgetLabel" android:text="+1 hr" />
    </LinearLayout>
</LinearLayout>
