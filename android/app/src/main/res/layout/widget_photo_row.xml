<?xml version="1.0" encoding="utf-8"?>
<!-- One city (medium and large widgets): its photo fills the row (pre-rendered with the time-of-day shading,
     the scrims and rounded corners); bottom-left the time (white on a dark photo, dark on a bright one),
     the name and what it's doing; bottom-right the hour before, now and the hour after. The Now capsule is
     drawn once over every row (widget_photo_root). Insets and weights match MeridianWidgets' geometry. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="bottom" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:orientation="vertical">
            <LinearLayout android:id="@+id/time_light" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:baselineAligned="true" android:orientation="horizontal" android:visibility="visible">
                <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:letterSpacing="-0.02" android:textColor="#FFFFFF" android:textSize="20sp" android:maxLines="1"
                    android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" />
                <TextView android:id="@+id/clock_static" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:letterSpacing="-0.02" android:textColor="#FFFFFF" android:textSize="20sp" android:maxLines="1"
                    android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" />
                <TextClock android:id="@+id/ampm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="2dp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="1"
                    android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" />
                <TextView android:id="@+id/ampm_static" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="2dp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="1"
                    android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" />
            </LinearLayout>
            <LinearLayout android:id="@+id/time_dark" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:baselineAligned="true" android:orientation="horizontal" android:visibility="gone">
                <TextClock android:id="@+id/clock_d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:letterSpacing="-0.02" android:textColor="#0A0E1C" android:textSize="20sp" android:maxLines="1"
                    android:shadowColor="#E6FFFFFF" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="3" />
                <TextView android:id="@+id/clock_static_d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:letterSpacing="-0.02" android:textColor="#0A0E1C" android:textSize="20sp" android:maxLines="1"
                    android:shadowColor="#E6FFFFFF" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="3" />
                <TextClock android:id="@+id/ampm_d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="2dp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:textColor="#0A0E1C" android:textSize="11sp" android:maxLines="1"
                    android:shadowColor="#E6FFFFFF" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="3" />
                <TextView android:id="@+id/ampm_static_d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="2dp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:textColor="#0A0E1C" android:textSize="11sp" android:maxLines="1"
                    android:shadowColor="#E6FFFFFF" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="3" />
            </LinearLayout>
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:textSize="12sp"
                android:shadowColor="#99000000" android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" />
            <LinearLayout android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:background="@drawable/widget_pill" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="7dp"
                android:paddingTop="1dp" android:paddingBottom="1dp" android:visibility="gone">
                <ImageView android:id="@+id/status_icon" android:layout_width="11dp" android:layout_height="11dp"
                    android:src="@drawable/ic_briefcase" android:importantForAccessibility="no" />
                <TextView android:id="@+id/status_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" android:textColor="#9AD3A8" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/tiles" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1.1"
            android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:id="@+id/tile0" style="@style/WidgetTile"
                    android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:textSize="14sp" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:id="@+id/tile1" style="@style/WidgetTile"
                    android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:textSize="14sp" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <TextView android:id="@+id/tile2" style="@style/WidgetTile"
                    android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
